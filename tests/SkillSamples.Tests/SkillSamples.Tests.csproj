<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles and runs the code samples shown in proven-dotnet skills, so a sample can't drift into code that
       doesn't build or doesn't do what the skill says. Run by .github/workflows/skill-samples.yml. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <!-- testing-tdd: the range that stops before 8.0 (paid licence) is in tests/Directory.Packages.props. -->
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="AutoFixture.AutoMoq" />
    <PackageReference Include="AutoFixture.Xunit2" />
    <PackageReference Include="NetArchTest.Rules" />
    <!-- cicd-github-actions: the sample workflows are read as YAML to test what they decide. -->
    <PackageReference Include="YamlDotNet" />
    <!-- project-skills -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
    <PackageReference Include="NATS.Net" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="DotNetCore.CAP" />
    <PackageReference Include="DotNetCore.CAP.PostgreSql" />
    <PackageReference Include="DotNetCore.CAP.RabbitMQ" />
    <PackageReference Include="Hl7.Fhir.R4" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Enrichers.Sensitive" />
    <!-- pii-masking: classified logging redacted before any provider; Serilog as a provider under it. -->
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
    <PackageReference Include="Microsoft.Extensions.Telemetry" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="StackExchange.Redis" />
    <!-- kubernetes-dotnet: the readiness check for Redis. -->
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <!-- caching: HybridCache with Redis as L2. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- aspire-patterns: ServiceDefaults (service discovery, OpenTelemetry). -->
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <!-- azure-deployment: a managed identity's token as the PostgreSQL password. -->
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Quartz.Extensions.Hosting" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="OpenIddict.Server.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.AspNetCore" />
    <PackageReference Include="OpenIddict.Validation.SystemNetHttp" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- OpenIddict's HTTP integration brings Polly 7 along; keep it out of compilation so Polly 8's types
         (BrokenCircuitException, TimeoutRejectedException) aren't ambiguous in the resilience samples. -->
    <PackageReference Include="Polly" ExcludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Scheduling/*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compliance/*.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- msbuild: a sample solution the tests copy to a temp folder and restore with the real CLI. -->
    <!-- cicd-github-actions: its sample workflows and the tests that read them live in tests/Workflows. -->
    <Compile Include="../Workflows/*.cs" Link="Workflows/%(Filename)%(Extension)" />
    <None Include="../Workflows/*.yml" Link="Workflows/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="MsBuild/**/*.props;MsBuild/**/*.csproj;MsBuild/nuget.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="CodeQuality/sample/**/*.props;CodeQuality/sample/**/*.csproj;CodeQuality/sample/.editorconfig" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Grpc/orders.proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SkillSamples.OrdersApi/SkillSamples.OrdersApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
