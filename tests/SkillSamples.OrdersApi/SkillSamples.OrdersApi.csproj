<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- A small service for the testing-integration samples: tests/SkillSamples.Tests/Integration starts it
       with WebApplicationFactory<Program>, the way a real service's tests do. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Transitive (via Microsoft.Data.SqlClient). 9.0.0-9.0.20 and 10.0.0-10.0.12 are affected by
         CVE-2026-70162 (GHSA-2fmv-rv2c-59x7, moderate) and CVE-2026-84008 (GHSA-846f-f764-76mx, high),
         both denial of service. Pinned to the first fixed 10.x until SqlClient depends on it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.*" />
  </ItemGroup>
</Project>
