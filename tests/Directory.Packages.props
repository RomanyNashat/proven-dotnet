<Project>
  <!-- One version per package for every test project under tests/ (the msbuild skill). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!-- The samples float on purpose: CI tests what a service restores today, so a breaking patch or a new
         advisory shows up here first. A service pins exact versions instead. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup Label="Test framework">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Moq" Version="4.20.*" />
    <PackageVersion Include="AutoFixture.AutoMoq" Version="4.*" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.*" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.*" />
    <PackageVersion Include="YamlDotNet" Version="16.*" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
    <!-- 8.0 and later need a paid licence for commercial use, so the range stops at 8. -->
    <PackageVersion Include="FluentAssertions" Version="[7.0.0,8.0.0)" />
  </ItemGroup>

  <ItemGroup Label="What the samples use">
    <PackageVersion Include="Confluent.Kafka" Version="2.*" />
    <PackageVersion Include="Dapper" Version="2.*" />
    <PackageVersion Include="DotNetCore.CAP" Version="10.*" />
    <PackageVersion Include="DotNetCore.CAP.PostgreSql" Version="10.*" />
    <PackageVersion Include="DotNetCore.CAP.RabbitMQ" Version="10.*" />
    <PackageVersion Include="FluentValidation" Version="12.*" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.*" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.*" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.*" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.*" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.20.*" />
    <PackageVersion Include="Hl7.Fhir.R4" Version="6.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.*" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.*" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Compliance.Redaction" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Telemetry" Version="10.*" />
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
    <PackageVersion Include="NATS.Net" Version="2.*" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.*" />
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.*" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.*" />
    <PackageVersion Include="OpenIddict.Validation.SystemNetHttp" Version="7.*" />
    <PackageVersion Include="Polly" Version="7.*" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.*" />
    <PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="3.*" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.*" />
    <PackageVersion Include="Respawn" Version="6.*" />
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Enrichers.Sensitive" Version="2.1.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.*" />
    <PackageVersion Include="StackExchange.Redis" Version="2.8.*" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="9.*" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.*" />
    <PackageVersion Include="Azure.Core" Version="1.*" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <!-- aspire-patterns: the AppHost in tests/SkillSamples.Aspire (its SDK version is in AppHost.csproj). -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.0.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.0.0" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.*" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.*" />
  </ItemGroup>

  <ItemGroup Label="Security pins">
    <!-- Arrives through Microsoft.Data.SqlClient. 9.0.0-9.0.20 and 10.0.0-10.0.12 are affected by
         CVE-2026-70162 (GHSA-2fmv-rv2c-59x7, moderate) and CVE-2026-84008 (GHSA-846f-f764-76mx, high), both
         denial of service. Pinned for every project here until SqlClient depends on a fixed version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Arrives through Aspire.Hosting 13.0.0 at 2.5.192. Versions below 2.5.301 (3.x below 3.1.7) are affected
         by CVE-2026-48509 (GHSA-2f33-pr97-265q), CVE-2026-48512 (GHSA-cj9g-3mj2-g8vv) and GHSA-2x83-8g95-xh59,
         all moderate. Pinned on the 2.x line Aspire uses, until it depends on a fixed version. -->
    <PackageVersion Include="MessagePack" Version="2.5.301" />
  </ItemGroup>
</Project>
