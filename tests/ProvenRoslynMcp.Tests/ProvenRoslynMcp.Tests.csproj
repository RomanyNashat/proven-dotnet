<Project Sdk="Microsoft.NET.Sdk">

  <!-- Regression tests for the proven-dotnet Roslyn MCP server. Lives OUTSIDE tools/proven-roslyn-mcp/ on purpose:
       that project compiles every .cs under its folder, so tests placed there would ship in the tool. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Direct reference so the BuildHost that loads solutions is copied into the test output. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/proven-roslyn-mcp/ProvenRoslynMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
