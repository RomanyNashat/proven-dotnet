+using System.Text;
+using HomeReadings.Api;
+using HomeReadings.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+namespace HomeReadings.Application;
+
+/// <summary>A patient's readings as CSV, to send to their doctor before a visit.</summary>
+public sealed class ReadingExport(ReadingsDbContext db, ICurrentPatient patient, ReadingQueries queries, ILogger<ReadingExport> logger)
+{
+    public async Task<string> AllAsync(DateTime from, DateTime to, CancellationToken ct)
+    {
+        var rows = await db.Readings.AsNoTracking()
+            .Where(r => r.PatientId == patient.Id && r.CollectedAt >= from && r.CollectedAt < to)
+            .OrderBy(r => r.CollectedAt)
+            .ToListAsync(ct);
+
+        var csv = new StringBuilder("collected_at,value,unit,notes\n");
+        foreach (var r in rows)
+        {
+            csv.Append(r.CollectedAt.ToString("O")).Append(',')
+               .Append(r.Value).Append(',')
+               .Append(r.Unit).Append(',')
+               .Append(r.Notes).Append('\n');
+        }
+
+        logger.LogInformation("Export for {NationalId}: {Rows} rows", rows.FirstOrDefault()?.NationalId, rows.Count);
+        return csv.ToString();
+    }
+
+    /// <summary>One reading, for the "share this reading" button.</summary>
+    public async Task<string?> OneAsync(int id, CancellationToken ct)
+    {
+        var reading = await queries.GetAsync(id, ct);
+        return reading is null ? null
+            : $"collected_at,value,unit,notes\n{reading.CollectedAt:O},{reading.Value},{reading.Unit},{reading.Notes}\n";
+    }
+}
