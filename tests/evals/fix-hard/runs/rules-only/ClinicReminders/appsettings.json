{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Sms": {
    "BaseUrl": "https://sms.example.net/api/v2/",
    "Timeout": "00:00:30"
  },
  "AllowedHosts": "*"
}
