<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests a fixer doesn't see. They run on .NET 10, against the copy being graded (the original by default). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
    <FixtureDir Condition="'$(FixtureDir)' == ''">$(MSBuildThisFileDirectory)../ClinicQueue</FixtureDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(FixtureDir)/ClinicQueue.csproj" />
    <Using Include="Xunit" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FixtureDir</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(FixtureDir)').TrimEnd('/'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
