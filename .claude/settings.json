{
  "cleanupPeriodDays": 120,
  "env": {
    "PROVEN_HOOK_PROFILE": "standard",
    "PROVEN_COMPRESS_OUTPUT": "0",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "MCP_TIMEOUT": "120000",
    "CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT": "600000"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/session-start.py"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/post-compact.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/post-edit-format.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(dotnet *)",
            "command": "{PYTHON} {HOOKS}/tdd-gate.py post"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/tdd-gate.py post"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/pre-compact.py",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/stop.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/tdd-gate.py done"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/journal.py prompt",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__proven-roslyn__rename_symbol",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/worktree-guard.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {HOOKS}/subagent-log.py",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(dotnet *)",
            "command": "{PYTHON} {HOOKS}/tdd-gate.py post"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(curl * | sudo)",
      "Bash(wget * | sudo)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(> /dev/sd*)",
      "Bash(chmod 777*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
